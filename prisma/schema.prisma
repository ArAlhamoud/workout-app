generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exercise {
  id           String       @id @default(cuid())
  name         String
  category     String
  pinIncrement Float?
  createdAt    DateTime     @default(now())
  sets         WorkoutSet[]
}

model Workout {
  id                String       @id @default(cuid())
  name              String
  date              DateTime     @default(now())
  gym               String?
  notes             String?
  duration          Int?
  avgHr             Int?
  maxHr             Int?
  activeKcal        Int?
  healthSyncedAt    DateTime?
  // UUID of the HKWorkout this session came from (or was matched to). Set only
  // by the auto-detect import; every hand-logged workout leaves it null, and
  // Postgres allows unlimited NULLs under a unique index. It is what stops an
  // already-imported Apple Health session from being offered a second time.
  // Additive — `prisma db push` adds the column and index with no data loss.
  healthWorkoutUuid String?      @unique
  // Client-generated save id — the outbox idempotency key. A save that timed
  // out but actually landed must not create a second workout when the outbox
  // replays it; createWorkout upserts on this. Null on every row saved before
  // the outbox existed. Additive; unlimited NULLs under a unique index.
  clientSaveId      String?      @unique
  // Downsampled in-workout heart-rate curve, [[offsetSec, bpm], ...], written
  // once by the native shell after save. Fill-null-only, never clobbered.
  hrSeries          Json?
  // One optional line captured at the welcome-back moment: what got in the
  // way before this comeback session. The highest-value missing datum in the
  // gap war — the coach reads it; nothing else does. Additive, nullable.
  gapReason         String?
  sets              WorkoutSet[]
  createdAt         DateTime     @default(now())

  @@index([date])
}

model WorkoutSet {
  id          String    @id @default(cuid())
  workoutId   String
  exerciseId  String
  setNumber   Int
  reps        Int
  weight      Float
  notes       String?
  rpe         Int?
  // Wall-clock moment the set was ticked done in the logger. Nullable and
  // never backfilled: sets saved without ticking (and every historical row)
  // simply have no stamp. Additive — `prisma db push` adds it with no data loss.
  completedAt DateTime?
  // Warm-up sets are logged but never counted: excluded from records, volume
  // and plateau detection. Default false, so every historical row stays a
  // working set. Additive — adds with a default, no data loss.
  isWarmup    Boolean   @default(false)
  workout     Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  @@index([exerciseId])
}

model BodyStat {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  weight    Float?
  waist     Float?
  arms      Float?
  // Body composition (health wave) — logged from the smart scale when he
  // cares to; never invented, never required. All additive and nullable.
  neckCm      Float?
  bodyFatPct  Float?
  muscleKg    Float?
  visceralFat Float?
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

// ── Health wave: Mounjaro treatment as the spine ─────────────────────────
// One user, tracker-not-diagnostic by design. Every insight computed from
// these rows is deterministic arithmetic with "not enough data" guards;
// correlation language only, never causation. All models additive.

// Singleton profile (fixed id "profile"): baseline + editable dose plan.
// dosePlan Json: [{week, mg|null, label?}] — null mg = checkpoint (doctor
// review), nothing auto-escalates past what he and his doctor decide.
model HealthProfile {
  id            String   @id
  heightCm      Float
  startWeightKg Float
  goalWeightKg  Float
  milestonesKg  Json?
  conditions    Json?
  dosePlan      Json?
  targets       Json?
  reminders     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A Mounjaro injection. The FIRST row anchors the treatment clock: week 1
// day 0 is the first logged injection, so "current week" and "next dose"
// derive from real events, never from an assumed start date.
model Injection {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  doseMg     Float
  penMg      Float?
  clicks     Int?
  // site: abdomen-left | abdomen-right | thigh-left | thigh-right |
  //       arm-left | arm-right
  site       String
  onSchedule Boolean  @default(true)
  needleInfo String?
  penId      String?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([at])
}

// Side effects AND GI symptoms in one table — they are one timeline, and
// the bloating↔AF question needs them joinable by day. kind is a fixed
// vocabulary (nausea, bloating, gas, reflux, burping, constipation,
// diarrhea, vomiting, abdominal-pain, fatigue, headache, dizziness,
// appetite-suppression, fullness). severity 0-3 (None/Mild/Moderate/
// Severe). context Json holds meal relation, minutes-after-meal, trigger
// food, Bristol scale — optional detail, never required for a 2-tap log.
model SymptomLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  kind      String
  severity  Int
  context   Json?
  notes     String?
  createdAt DateTime @default(now())

  @@index([at, kind])
}

// An AF / palpitation episode. The boolean flags are the correlation
// substrate (bloating? gas? after a meal?) — nullable means "not asked",
// false means "asked and no", and analytics must respect the difference.
model AfEpisode {
  id            String    @id @default(cuid())
  startedAt     DateTime
  endedAt       DateTime?
  durationMin   Int?
  hrBpm         Int?
  symptoms      String?
  ecgRecorded   Boolean   @default(false)
  bloating      Boolean?
  gas           Boolean?
  afterMeal     Boolean?
  sleepRelated  Boolean?
  exerciseRelated Boolean?
  caffeine      Boolean?
  dehydration   Boolean?
  stress        Boolean?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([startedAt])
}

model BpReading {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  systolic  Int
  diastolic Int
  pulse     Int?
  // context: morning | evening | before-med | after-med | clinic
  context   String?
  seated    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  @@index([at])
}

// One row per night (unique bare date), numbers copied from the Löwenstein
// prisma APP. The primary adherence metric is usageHours vs sleep, not a
// pass/fail 4-hour line.
model CpapNight {
  id           String   @id @default(cuid())
  night        DateTime @unique
  usageHours   Float
  ahi          Float?
  leak         Float?
  avgPressure  Float?
  p95Pressure  Float?
  maskComfort  Int?
  sleepQuality Int?
  notes        String?
  createdAt    DateTime @default(now())
}

model LabResult {
  id        String   @id @default(cuid())
  date      DateTime
  // test slug: ldl, hdl, total-chol, triglycerides, apob, lpa, hba1c,
  // glucose, alt, ast, creatinine, egfr, potassium, magnesium, calcium,
  // tsh, vitamin-d — free-form slugs allowed for anything else.
  test      String
  value     Float
  unit      String
  refLow    Float?
  refHigh   Float?
  lab       String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([test, date])
}

model Medication {
  id         String    @id @default(cuid())
  name       String
  doseLabel  String
  frequency  String
  startedOn  DateTime?
  stoppedOn  DateTime?
  prescriber String?
  notes      String?
  createdAt  DateTime  @default(now())
}

// Lightweight by decision (the kill-list already executed calorie
// counting): protein, water, fiber, meal flags. One row per bare day.
model NutritionLog {
  id        String   @id @default(cuid())
  day       DateTime @unique
  proteinG  Int?
  waterMl   Int?
  fiberG    Int?
  meals     Int?
  // Daily macro totals (Fuel tracker, Aug 2026 — owner reversed the
  // calorie-counting kill-list once the meal subscription made the numbers
  // free to copy). All nullable: a day with only protein logged stays valid.
  kcal      Int?
  carbsG    Int?
  fatG      Int?
  flags     Json?
  notes     String?
  createdAt DateTime @default(now())
}

// A declared "holding, not losing" window — MacroFactor's diet break, adapted.
// Converts the failure mode from unbounded (43 silent days) into bounded: a
// hold has an expiry, pauses the Gap Guard ladder and coaching pressure, and
// its weeks are excused from the streak. Ending early is one tap.
model Hold {
  id        String   @id @default(cuid())
  startsAt  DateTime @default(now())
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([endsAt])
}

// One generated coach note per calendar day — the real coach's morning
// brief. Generated lazily on first request of the day, then served from
// here; the app never blocks on the model. Additive.
model CoachNote {
  id         String   @id @default(cuid())
  // Bare local calendar day ("2026-08-05") — one note per day.
  day        String   @unique
  brief      String
  directives Json?
  // One approvable lever ({action, days?, reason?}) — rendered as an
  // Approve button, executed only by an explicit tap through a server
  // action that re-clamps every bound. Additive, nullable.
  proposal   Json?
  model      String
  createdAt  DateTime @default(now())
}

// Coach-written gap-ladder notification copy, one row per calendar day
// (row-as-lock, same cost-bound pattern as CoachNote). `anchor` is the bare
// date of the last training session the copy was composed against — copy is
// only served while that anchor still holds, and regenerated (at most once
// more that day) when a new session moves it. `copy` null = attempted and
// failed/rejected: the static ladder stands, no retry until tomorrow.
model CoachLadderCopy {
  id        String   @id @default(cuid())
  day       String   @unique
  anchor    String
  copy      Json?
  model     String
  createdAt DateTime @default(now())
}

model HealthSample {
  id        String   @id @default(cuid())
  type      String
  date      DateTime
  value     Float
  unit      String
  source    String   @default("apple-health")
  meta      String?
  createdAt DateTime @default(now())

  @@unique([type, date, source])
  @@index([type, date])
}

// The one in-flight session, shared by the phone logger and the Watch so a
// workout can start on either device and continue on the other (owner,
// 2026-09-01). Keyed by the client save id both devices finish with, so
// the finish dedupes/merges into ONE Workout. Single user → at most one
// open row matters; opening a new one closes the rest. Sets are JSON
// (exerciseId, setNumber, reps, weight, rpe?, isWarmup?, completedAt,
// source) merged by exercise+set number, later completion wins. Rows are
// small and short-lived; closed rows are kept for a while as an audit of
// the handoff and pruned by the sync job. Additive — a new table.
model LiveSession {
  clientSaveId String    @id
  day          String?
  durationMin  Int?
  gym          String?
  source       String
  startedAt    DateTime
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?
  workoutId    String?
  sets         Json      @default("[]")

  @@index([closedAt])
}
