generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exercise {
  id           String       @id @default(cuid())
  name         String
  category     String
  pinIncrement Float?
  createdAt    DateTime     @default(now())
  sets         WorkoutSet[]
}

model Workout {
  id                String       @id @default(cuid())
  name              String
  date              DateTime     @default(now())
  gym               String?
  notes             String?
  duration          Int?
  avgHr             Int?
  maxHr             Int?
  activeKcal        Int?
  healthSyncedAt    DateTime?
  // UUID of the HKWorkout this session came from (or was matched to). Set only
  // by the auto-detect import; every hand-logged workout leaves it null, and
  // Postgres allows unlimited NULLs under a unique index. It is what stops an
  // already-imported Apple Health session from being offered a second time.
  // Additive — `prisma db push` adds the column and index with no data loss.
  healthWorkoutUuid String?      @unique
  // Client-generated save id — the outbox idempotency key. A save that timed
  // out but actually landed must not create a second workout when the outbox
  // replays it; createWorkout upserts on this. Null on every row saved before
  // the outbox existed. Additive; unlimited NULLs under a unique index.
  clientSaveId      String?      @unique
  // Downsampled in-workout heart-rate curve, [[offsetSec, bpm], ...], written
  // once by the native shell after save. Fill-null-only, never clobbered.
  hrSeries          Json?
  // One optional line captured at the welcome-back moment: what got in the
  // way before this comeback session. The highest-value missing datum in the
  // gap war — the coach reads it; nothing else does. Additive, nullable.
  gapReason         String?
  sets              WorkoutSet[]
  createdAt         DateTime     @default(now())

  @@index([date])
}

model WorkoutSet {
  id          String    @id @default(cuid())
  workoutId   String
  exerciseId  String
  setNumber   Int
  reps        Int
  weight      Float
  notes       String?
  rpe         Int?
  // Wall-clock moment the set was ticked done in the logger. Nullable and
  // never backfilled: sets saved without ticking (and every historical row)
  // simply have no stamp. Additive — `prisma db push` adds it with no data loss.
  completedAt DateTime?
  // Warm-up sets are logged but never counted: excluded from records, volume
  // and plateau detection. Default false, so every historical row stays a
  // working set. Additive — adds with a default, no data loss.
  isWarmup    Boolean   @default(false)
  workout     Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  @@index([exerciseId])
}

model BodyStat {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  weight    Float?
  waist     Float?
  arms      Float?
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

// A declared "holding, not losing" window — MacroFactor's diet break, adapted.
// Converts the failure mode from unbounded (43 silent days) into bounded: a
// hold has an expiry, pauses the Gap Guard ladder and coaching pressure, and
// its weeks are excused from the streak. Ending early is one tap.
model Hold {
  id        String   @id @default(cuid())
  startsAt  DateTime @default(now())
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([endsAt])
}

// One generated coach note per calendar day — the real coach's morning
// brief. Generated lazily on first request of the day, then served from
// here; the app never blocks on the model. Additive.
model CoachNote {
  id         String   @id @default(cuid())
  // Bare local calendar day ("2026-08-05") — one note per day.
  day        String   @unique
  brief      String
  directives Json?
  // One approvable lever ({action, days?, reason?}) — rendered as an
  // Approve button, executed only by an explicit tap through a server
  // action that re-clamps every bound. Additive, nullable.
  proposal   Json?
  model      String
  createdAt  DateTime @default(now())
}

// Coach-written gap-ladder notification copy, one row per calendar day
// (row-as-lock, same cost-bound pattern as CoachNote). `anchor` is the bare
// date of the last training session the copy was composed against — copy is
// only served while that anchor still holds, and regenerated (at most once
// more that day) when a new session moves it. `copy` null = attempted and
// failed/rejected: the static ladder stands, no retry until tomorrow.
model CoachLadderCopy {
  id        String   @id @default(cuid())
  day       String   @unique
  anchor    String
  copy      Json?
  model     String
  createdAt DateTime @default(now())
}

model HealthSample {
  id        String   @id @default(cuid())
  type      String
  date      DateTime
  value     Float
  unit      String
  source    String   @default("apple-health")
  meta      String?
  createdAt DateTime @default(now())

  @@unique([type, date, source])
  @@index([type, date])
}
