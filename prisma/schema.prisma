generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exercise {
  id           String       @id @default(cuid())
  name         String
  category     String
  pinIncrement Float?
  createdAt    DateTime     @default(now())
  sets         WorkoutSet[]
}

model Workout {
  id                String       @id @default(cuid())
  name              String
  date              DateTime     @default(now())
  gym               String?
  notes             String?
  duration          Int?
  avgHr             Int?
  maxHr             Int?
  activeKcal        Int?
  healthSyncedAt    DateTime?
  // UUID of the HKWorkout this session came from (or was matched to). Set only
  // by the auto-detect import; every hand-logged workout leaves it null, and
  // Postgres allows unlimited NULLs under a unique index. It is what stops an
  // already-imported Apple Health session from being offered a second time.
  // Additive — `prisma db push` adds the column and index with no data loss.
  healthWorkoutUuid String?      @unique
  sets              WorkoutSet[]
  createdAt         DateTime     @default(now())

  @@index([date])
}

model WorkoutSet {
  id          String    @id @default(cuid())
  workoutId   String
  exerciseId  String
  setNumber   Int
  reps        Int
  weight      Float
  notes       String?
  rpe         Int?
  // Wall-clock moment the set was ticked done in the logger. Nullable and
  // never backfilled: sets saved without ticking (and every historical row)
  // simply have no stamp. Additive — `prisma db push` adds it with no data loss.
  completedAt DateTime?
  workout     Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  @@index([exerciseId])
}

model BodyStat {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  weight    Float?
  waist     Float?
  arms      Float?
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

model HealthSample {
  id        String   @id @default(cuid())
  type      String
  date      DateTime
  value     Float
  unit      String
  source    String   @default("apple-health")
  meta      String?
  createdAt DateTime @default(now())

  @@unique([type, date, source])
  @@index([type, date])
}
