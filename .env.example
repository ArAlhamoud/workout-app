# Neon Postgres connection string (pooled), e.g.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=""

# Shared secret for the /api/health/* routes (Apple Health bridge).
# Not auth — this is a single-user app; the token just keeps random
# internet traffic from writing to your data.
# Generate one with: openssl rand -hex 32
HEALTH_SYNC_TOKEN=""
